# =============================================================================
# Reta / EDUHACK — variables de entorno
# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# Las variables sin prefijo NEXT_PUBLIC_ solo existen en el servidor.
# =============================================================================

# --- Supabase (requerido) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se usa para escrituras que el estudiante no debe poder falsificar.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública del sitio (para redirecciones OAuth y enlaces de portafolio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Proveedor de IA (requerido: uno de los dos) -----------------------------
AI_PROVIDER=anthropic            # anthropic | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5  # verificado en documentación oficial 2026-11-17
ANTHROPIC_SERVER_FALLBACKS=default  # default | off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash    # verificado en ai.google.dev 2026-11-17
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Límites y costos
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_HOURLY_REQUEST_LIMIT=60
# Precios opcionales por millón de tokens para modelos sin precio integrado:
# AI_PRICING_JSON={"gemini-3.8-flash":{"input":0,"output":0}}
AI_PRICING_JSON=

# --- Proveedores de recursos -------------------------------------------------
YOUTUBE_API_KEY=                 # sin clave: YouTube queda en "configuración pendiente"
OPENALEX_API_KEY=                # opcional (amplía la cuota diaria)
CONTACT_EMAIL=                   # opcional: polite pool de Crossref
GITHUB_TOKEN=                    # opcional: token fine-grained de solo lectura
